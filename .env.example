VITE_API_BASE_URL=http://localhost:3001/api

# Telegram / Mini App
MINIAPP_URL=https://your-domain.com/p/app
PUBLIC_BASE_URL=https://your-domain.com
TELEGRAM_WEBHOOK_SECRET=replace_with_strong_secret
TELEGRAM_INITDATA_MAX_AGE_SECONDS=43200

# Feature flags
FF_CAR_CARD_V2=false
FF_BOT_A_FLOW_V2=false
FF_B2B_WHITELIST_ENFORCED=false
FF_B2B_FIT_QUEUE_V2=false
FF_MINIAPP_B2B_CABINET=false
TELEGRAM_B2B_LEGACY_FALLBACK=false

# Bot limits
BOT_A_DAILY_LEAD_LIMIT=5
BOT_STEP_RATE_LIMIT_PER_MIN=30
BOT_MEDIA_MAX_PHOTO_BYTES=10485760

# Meta analytics / Conversions API
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_CAPI_ENABLED=false

# B2C Bot Meta CAPI dataset (disabled until QA)
META_B2C_BOT_DATASET_ID=1152615213548168
META_B2C_BOT_DESTINATION_KEY=b2c_bot_sandbox
META_B2C_BOT_ACCESS_TOKEN=
META_B2C_BOT_TEST_EVENT_CODE=TEST46105
META_B2C_BOT_CAPI_ENABLED=false
META_B2C_BOT_PURCHASE_ENABLED=false
META_B2C_BOT_TEST_MODE=true

# First-party attribution redirects for Meta ads
ATTRIBUTION_REDIRECT_ENABLED=false
ATTRIBUTION_SESSION_TTL_DAYS=30
ATTRIBUTION_DEFAULT_DESTINATION=b2c_bot_sandbox
ATTRIBUTION_BOT_ALLOWLIST=b2c_bot_sandbox:cartie_client_bot
# Use /r/quiz?destination=adsquiz_usa&fbclid=... in ads; only allowlisted URLs are redirected.
ATTRIBUTION_WEB_ALLOWLIST=adsquiz_usa=https://cartieua.adsquiz.io/1lCcazQtVN
ATTRIBUTION_REDIRECT_FAIL_MODE=closed

# SalesDrive connector (read-only by default)
SALESDRIVE_API_BASE_URL=https://yourdomain.salesdrive.me
SALESDRIVE_API_KEY=
SALESDRIVE_ORDER_CREATE_PATH=/handler/
SALESDRIVE_ORDER_LIST_PATH=/api/order/list/
SALESDRIVE_STATUSES_PATH=/api/statuses/
SALESDRIVE_SYNC_ENABLED=false
SALESDRIVE_WRITE_ENABLED=false
SALESDRIVE_TIMEOUT_MS=8000
SALESDRIVE_WEBHOOK_SECRET=replace_with_strong_secret
SALESDRIVE_B2C_WEBHOOK_ACCOUNT_ALLOWLIST=cartie
SALESDRIVE_B2C_WEBHOOK_FORM_ALLOWLIST=1
SALESDRIVE_DEFAULT_CURRENCY=USD
SALESDRIVE_WEBHOOK_TIMEZONE_OFFSET_MINUTES=180
# JSON rules. Default without this key is only status 13 -> Contacted.
# Enable Purchase only with META_B2C_BOT_PURCHASE_ENABLED=true and approved value/currency rules.
SALESDRIVE_B2C_META_STATUS_MAP=[{"statusIds":["1"],"eventName":"Lead","crmStatus":"lead"},{"statusIds":["2","9"],"eventName":"QualifiedLead","crmStatus":"qualified_lead"},{"statusIds":["13"],"eventName":"Contacted","crmStatus":"contacted"},{"statusNames":["запис","бронь","консультац"],"eventName":"Schedule","crmStatus":"scheduled"},{"statusIds":["5","11"],"eventName":"Purchase","crmStatus":"purchase","requireValue":true,"requireCurrency":true}]
