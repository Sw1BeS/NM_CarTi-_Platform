# Server
PORT=3001
NODE_ENV=production

# Database
DATABASE_URL=postgresql://cartie:password@db:5432/cartie_db?schema=public
POSTGRES_PASSWORD=change_me

# Auth
JWT_SECRET=replace_with_strong_secret
CORS_ORIGIN=https://cartie2.umanoff-analytics.space

# Seed user
SEED_ADMIN_EMAIL=admin@cartie.com
SEED_ADMIN_PASSWORD=change_me
SEED_SUPERADMIN_EMAIL=superadmin@cartie.com
SEED_SUPERADMIN_PASSWORD=change_me

# ========================================
# v4.1 Feature Flags (Zero-Downtime Rollout)
# ========================================

# PR-0: Enable workspace scoping middleware
USE_V4_WORKSPACE_SCOPING=false

# PR-2: Enable dual-write to both legacy and v4.1 tables
USE_V4_DUAL_WRITE=false

# PR-4: Switch reads from legacy to v4.1 tables
USE_V4_READS=false

# PR-4: Enable shadow reads for parity checking
USE_V4_SHADOW_READS=false

# ========================================
# Integrations (Optional Defaults)
# ========================================
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
META_CAPI_ENABLED=false

# B2C Bot Meta CAPI dataset (disabled until QA)
META_B2C_BOT_DATASET_ID=1152615213548168
META_B2C_BOT_DESTINATION_KEY=b2c_bot_sandbox
META_B2C_BOT_ACCESS_TOKEN=
META_B2C_BOT_TEST_EVENT_CODE=TEST46105
META_B2C_BOT_CAPI_ENABLED=false
META_B2C_BOT_PURCHASE_ENABLED=false
META_B2C_BOT_TEST_MODE=true
SENDPULSE_ID=
SENDPULSE_SECRET=
AUTORIA_API_KEY=

# Vehicle taxonomy sync is dry-run by default. Set this only for an intentional operator-run write.
ALLOW_VEHICLE_TAXONOMY_SYNC_WRITE=0
KATOTTG_CSV_URL=https://api.directory.org.ua/api/katottg/download/csv
GEONAMES_TSV_URL=

# SalesDrive connector (read-only by default)
SALESDRIVE_API_BASE_URL=https://yourdomain.salesdrive.me
SALESDRIVE_API_KEY=
SALESDRIVE_ORDER_CREATE_PATH=/handler/
SALESDRIVE_ORDER_LIST_PATH=/api/order/list/
SALESDRIVE_STATUSES_PATH=/api/statuses/
SALESDRIVE_SYNC_ENABLED=false
SALESDRIVE_WRITE_ENABLED=false
SALESDRIVE_TIMEOUT_MS=8000
SALESDRIVE_WEBHOOK_SECRET=replace_with_strong_secret

# ========================================
# Telegram / Mini App
# ========================================
MINIAPP_URL=https://your-domain.com/p/app
PUBLIC_BASE_URL=https://your-domain.com
TELEGRAM_WEBHOOK_SECRET=replace_with_strong_secret
