}

model ImportSource {
  id           String            @id @default(cuid())
  companyId    String            @db.Char(26)
  workspace    Workspace         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  intakeId     String?
  intake       AutomationIntake? @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  name         String
  sourceType   String
  status       String            @default("REGISTERED")
  sourceUri    String?
  contentType  String?
  description  String?
  metadata     Json?             @db.JsonB
  registeredAt DateTime          @default(now())
  analyzedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  batches ImportBatch[]

  @@index([companyId, sourceType])
  @@index([companyId, status])
  @@index([intakeId])
}

model ImportBatch {
  id                 String                     @id @default(cuid())
  companyId          String                     @db.Char(26)
  workspace          Workspace                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  importSourceId     String
  importSource       ImportSource               @relation(fields: [importSourceId], references: [id], onDelete: Cascade)
  status             String                     @default("REGISTERED")
  batchLabel         String?
  itemCount          Int                        @default(0)
  rawPayload         Json?                      @db.JsonB
  analysisSummary    Json?                      @db.JsonB
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  items              ImportItem[]
  linkageCandidates  ImportLinkageCandidate[]
  recommendedActions ImportRecommendedAction[]
  writeCandidates    ImportWriteCandidate[]
  reviewQueue        AutomationReviewQueue[]

  @@index([companyId, status])
  @@index([importSourceId, createdAt])
}

model ImportItem {
  id             String                  @id @default(cuid())
  companyId      String                  @db.Char(26)
  workspace      Workspace               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  importBatchId  String
  importBatch    ImportBatch             @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  externalId     String?
  sourceUrl      String?
  mimeType       String?
  title          String?
  contentText    String?
  rawPayload     Json?                   @db.JsonB
  classification Json?                   @db.JsonB
  status         String                  @default("REGISTERED")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  linkageCandidates  ImportLinkageCandidate[]
  recommendedActions ImportRecommendedAction[]
  writeCandidates    ImportWriteCandidate[]

  @@index([companyId, status])
  @@index([importBatchId, createdAt])
  @@index([externalId])
}

model ImportLinkageCandidate {
  id            String      @id @default(cuid())
  companyId     String      @db.Char(26)
  workspace     Workspace   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  importItemId  String?
  importItem    ImportItem? @relation(fields: [importItemId], references: [id], onDelete: SetNull)
  targetType    String
  targetId      String?
  confidence    Float       @default(0)
  reason        String?
  payload       Json?       @db.JsonB
  status        String      @default("PROPOSED")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([companyId, status])
  @@index([importBatchId, confidence])
  @@index([importItemId])
}

model ImportRecommendedAction {
  id            String      @id @default(cuid())
  companyId     String      @db.Char(26)
  workspace     Workspace   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  importBatchId String
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
