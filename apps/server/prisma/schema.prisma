  refType        String
  label          String
  location       String
  trustLevel     String           @default("MEDIUM")
  freshnessState String           @default("REVIEW")
  rank           Int              @default(0)
  metadata       Json?            @db.JsonB
  createdAt      DateTime         @default(now())

  @@index([companyId, refType])
  @@index([intakeId, rank])
}

model AutomationSkillPack {
  id                       String           @id @default(cuid())
  companyId                String           @db.Char(26)
  workspace                Workspace        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  intakeId                 String
  intake                   AutomationIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)
  status                   String           @default("ACTIVE")
  taskContext              Json?            @db.JsonB
  relatedEntities          Json?            @db.JsonB
  sourcesUsed              Json?            @db.JsonB
  internalDocsUsed         Json?            @db.JsonB
  officialDocsUsed         Json?            @db.JsonB
  externalReferencesUsed   Json?            @db.JsonB
  bestPracticesUsed        Json?            @db.JsonB
  freshnessState           String           @default("REVIEW")
  riskLevel                String           @default("LOW")
  suggestedPromptAdditions Json?            @db.JsonB
  suggestedTools           String[]         @default([])
  operatorNotes            String?
  generatedAt              DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  runs AutomationRun[]

  @@index([companyId, freshnessState])
  @@index([companyId, generatedAt])
  @@index([intakeId, generatedAt])
}

model AutomationRun {
  id             String               @id @default(cuid())
  companyId      String               @db.Char(26)
  workspace      Workspace            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  intakeId       String?
  intake         AutomationIntake?    @relation(fields: [intakeId], references: [id], onDelete: SetNull)
  skillPackId    String?
  skillPack      AutomationSkillPack? @relation(fields: [skillPackId], references: [id], onDelete: SetNull)
  runType        String
  status         String               @default("PENDING")
  triggerSource  String               @default("MANUAL")
  beforeText     String?
  afterText      String?
  matchedAliases String[]             @default([])
  explanation    String?
  result         Json?                @db.JsonB
  createdBy      String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  steps AutomationRunStep[]

  @@index([companyId, runType, createdAt])
  @@index([companyId, status])
  @@index([intakeId])
  @@index([skillPackId])
}

model AutomationRunStep {
  id          String        @id @default(cuid())
  runId       String
  run         AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stepKey     String
  status      String        @default("PENDING")
  sequence    Int           @default(0)
  message     String?
  details     Json?         @db.JsonB
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

