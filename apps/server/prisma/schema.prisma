  inputText       String?
  sourceUrl       String?
  normalizedText  String?
  classification  String?
  relatedEntities Json?                @db.JsonB
  metadata        Json?                @db.JsonB
  createdBy       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  sourceRefs    AutomationSourceRef[]
  skillPacks    AutomationSkillPack[]
  runs          AutomationRun[]
  importSources ImportSource[]
  reviewQueue   AutomationReviewQueue[]

  @@index([companyId, createdAt])
  @@index([companyId, sourceType])
  @@index([companyId, status])
}

model AutomationSourceRef {
  id             String           @id @default(cuid())
  companyId      String           @db.Char(26)
  workspace      Workspace        @relation(fields: [companyId], references: [id], onDelete: Cascade)
